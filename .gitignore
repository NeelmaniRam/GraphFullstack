# OS
.DS_Store
Thumbs.db

# Editors/IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Node
node_modules/
npm-debug.log
yarn-error.log
dist/
build/

# Python
__pycache__/
*.py[cod]
*.venv/
venv/
.env
.env.*.local

# Java/Gradle/Maven
*.class
/build/
/target/

# general logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# Data: usually large files, keep out of git; if you must include small sample files, whitelist them
/data/*
!/data/.gitkeep
# Alternatively, if you want to version small dataset files, remove the data rule above.

# Secrets / keys
*.pem
*.key
credentials.json

# OS temp files
*.swp
*.swo
*.tmp

# Scripts build artifacts
/scripts/*.o
/scripts/*.out

# GitHub Actions cache (if any)
.github/workflows/.cache/